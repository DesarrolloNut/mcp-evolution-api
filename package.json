{
  "name": "mcp-whatsapp",
  "version": "2.0.0",
  "description": "Unified Multi-Channel WhatsApp MCP Gateway with Admin Panel, Provider Abstraction and Persistent Storage.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesarrolloNut/mcp-whatsapp.git"
  },
  "homepage": "https://github.com/DesarrolloNut/mcp-whatsapp#readme",
  "bugs": {
    "url": "https://github.com/DesarrolloNut/mcp-whatsapp/issues"
  },
  "bin": {
    "mcp-whatsapp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "docker-compose.yml"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/interfaces/web/panel', 'dist/interfaces/web/panel', {recursive: true}); require('node:fs').cpSync('src/interfaces/docs', 'dist/interfaces/docs', {recursive: true})\"",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "db:backup": "node dist/infrastructure/database/backup.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whatsapp",
    "evolution-api",
    "meta-cloud-api",
    "twilio",
    "gateway",
    "multichannel"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.2"
  }
}
