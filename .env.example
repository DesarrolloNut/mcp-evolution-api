# ==============================================================================
# mcp-whatsapp v2.0 - Configuration
# ==============================================================================

# ── Server & Runtime Mode ─────────────────────────────────────────────────────
# "server" (default): Inicia el Gateway HTTP centralizado (MCP SSE + Panel Web + REST API).
# "stdio": Modo clásico por consola (solo para compatibilidad con clientes v1.x sin red).
WHATSAPP_MODE=server
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# ── AI Agents Authentication (MCP Protocol) ──────────────────────────────────
# Token Bearer requerido por los agentes IA (Claude Desktop, Cursor, Claude Code).
# Dejar vacío SOLO en desarrollo local para permitir conexiones sin autenticación.
MCP_API_TOKEN=your-secret-mcp-agent-token

# ── Administration Panel & REST API ──────────────────────────────────────────
# Credenciales del usuario administrador para acceder a http://localhost:3000/panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Clave secreta para firmar tokens JWT de sesión (se autogenera al iniciar si está vacía).
# ADMIN_JWT_SECRET=your-secure-jwt-signing-secret

# ── Security & Encryption ─────────────────────────────────────────────────────
# Clave secreta de 32 bytes para cifrar las API keys de los proveedores en SQLite (AES-256-GCM).
# ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ── Database & Persistence (Mounted Storage) ──────────────────────────────────
# Ruta del archivo SQLite montado en disco. En Docker se monta en /app/data.
SQLITE_PATH=./data/mcp-whatsapp.db

# ==============================================================================
# ℹ️ PROVEEDORES Y LÍNEAS TELEFÓNICAS (100% DINÁMICOS):
#
# A diferencia de versiones anteriores, los proveedores (Evolution API, Meta, Twilio)
# y sus números/canales NO se configuran aquí en variables de entorno.
#
# Se registran de forma DINÁMICA desde el panel web (http://localhost:3000/panel)
# o mediante la REST API, permitiendo tener múltiples líneas y proveedores
# simultáneos sin reiniciar el servidor ni editar archivos de configuración.
# ==============================================================================
