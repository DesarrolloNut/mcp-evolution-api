# ==============================================================================
# mcp-whatsapp v2.0 - Configuration
# ==============================================================================

# ── Server & Runtime Mode ─────────────────────────────────────────────────────
# "server" runs the unified HTTP service (MCP SSE + Admin REST API + Web Panel).
# "stdio" runs in legacy CLI mode reading directly from EVOLUTION_* variables.
WHATSAPP_MODE=server
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# ── AI Agents Authentication (MCP Protocol) ──────────────────────────────────
# Bearer token required for MCP clients (Claude Desktop, Cursor, etc.).
# Leave empty ONLY during local development to disable authentication.
MCP_API_TOKEN=your-secret-mcp-agent-token

# ── Administration Panel & REST API ──────────────────────────────────────────
# Single administrative user credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Secret key used to sign Admin JWT tokens (randomly generated at startup if empty).
# ADMIN_JWT_SECRET=your-secure-jwt-signing-secret

# ── Security & Encryption ─────────────────────────────────────────────────────
# 32-byte secret key used to encrypt provider API keys in SQLite (AES-256-GCM).
# Keep this key safe; losing it prevents decrypting existing provider credentials.
# ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ── Database & Persistence (Mounted Storage) ──────────────────────────────────
# Path to SQLite database. In Docker, mount host volume to /app/data.
SQLITE_PATH=./data/mcp-whatsapp.db

# ── Legacy Evolution API (Used when WHATSAPP_MODE=stdio) ─────────────────────
# Base URL of your Evolution API instance (no trailing slash)
EVOLUTION_BASE_URL=https://your-evolution-instance.com

# Global API key (header: apikey).
EVOLUTION_API_KEY=your-global-apikey

# Optional: default WhatsApp instance name used when a tool call omits "instance"
EVOLUTION_DEFAULT_INSTANCE=myinstance

# Optional: comma-separated allowlist of tool groups to expose in stdio mode
# EVOLUTION_TOOLS=message,chat,group

# Optional: request timeout in milliseconds (default 30000)
# EVOLUTION_TIMEOUT_MS=30000
